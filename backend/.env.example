# Copy to .env and fill in real values. Never commit real secrets.

ENV=development
DEBUG=true

# IMPORTANT: the hostnames "mysql" and "redis" below only resolve INSIDE
# the Docker network created by docker-compose. If you're running the
# backend directly (uvicorn app.main:app, not `docker compose up`), you
# MUST change both to "localhost" or you'll get a 500 Internal Server
# Error on every endpoint that touches the database (including register),
# with "Can't connect to MySQL server on 'mysql'" in the logs.
#
#   Docker (docker compose up):  DATABASE_URL=mysql+pymysql://cloudvault:cloudvault@mysql:3306/cloudvault
#   Local (uvicorn directly):    DATABASE_URL=mysql+pymysql://cloudvault:cloudvault@localhost:3306/cloudvault
DATABASE_URL=mysql+pymysql://cloudvault:cloudvault@mysql:3306/cloudvault

# Same rule applies here — use localhost:6379 instead of redis:6379 for
# local (non-Docker) dev.
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

JWT_SECRET_KEY=replace_with_a_long_random_value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FILE_ENCRYPTION_KEY=replace_with_a_generated_32_byte_key

STORAGE_BACKEND=local
LOCAL_STORAGE_ROOT=/data/storage
CHUNK_SIZE_BYTES=5242880
MAX_FILE_SIZE_BYTES=10737418240

S3_ENDPOINT_URL=
S3_BUCKET=cloudvault
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

RATE_LIMIT_LOGIN_ATTEMPTS=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=300

DEFAULT_USER_QUOTA_BYTES=16106127360

CORS_ORIGINS=["http://localhost:5173"]

# Leave SENTRY_DSN empty to keep Sentry fully inactive (default). Set it
# to enable error tracking - no code changes needed.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Exposes GET /metrics in Prometheus text format for a Prometheus server
# to scrape; point Grafana at that Prometheus instance for dashboards.
PROMETHEUS_ENABLED=true
