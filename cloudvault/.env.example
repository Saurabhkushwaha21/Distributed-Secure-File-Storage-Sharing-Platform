# Copy to .env, fill in every value, then:
#   docker compose --env-file .env up -d --build
# Never commit the filled-in .env — only this .example is meant to be committed.

# ===== MySQL =====
MYSQL_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
MYSQL_ROOT_PASSWORD=REPLACE_WITH_STRONG_ROOT_PASSWORD

# ===== Redis =====
REDIS_PASSWORD=REPLACE_WITH_STRONG_REDIS_PASSWORD

# ===== JWT =====
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=REPLACE_ME_GENERATE_A_LONG_RANDOM_SECRET

# ===== File encryption (AES-256 envelope encryption master key) =====
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing this key permanently loses every stored file — back it up
# separately from the database (a secrets manager, not source control).
FILE_ENCRYPTION_KEY=REPLACE_WITH_A_GENERATED_32_BYTE_KEY

# ===== CORS =====
# The frontend and API share one origin behind nginx in this compose
# setup, so this mostly matters if something calls the API directly
# (e.g. a mobile app, or local dev against a deployed backend).
CORS_ORIGINS=["https://your-domain.com"]
